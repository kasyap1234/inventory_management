# Environment Variables Configuration
# Copy this file to .env and update all values before deploying to production
# SECURITY WARNING: Never commit .env file to version control

# ====================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ====================================================================
# Copy this to .env and update with secure values before running docker-compose
# SECURITY WARNING: Never commit .env file to version control

# Database Configuration (Required)
POSTGRES_DB=agromart2
POSTGRES_USER=agromart_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Redis Configuration (Required)  
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD

# Security Configuration (Required)
JWT_SECRET=GENERATE_256_BIT_SECRET_HERE_OPENSSL_RAND_BASE64_32
CSRF_SECRET=GENERATE_256_BIT_SECRET_HERE_OPENSSL_RAND_BASE64_32

# MinIO/S3 Configuration (Required)
MINIO_ACCESS_KEY=CHANGE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_MINIO_SECRET_KEY

# PgAdmin Configuration (Optional)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_PGADMIN_PASSWORD

# ====================================================================
# APPLICATION ENVIRONMENT VARIABLES
# ====================================================================
# Set the environment mode: development, staging, production
# Production mode enforces strict security validation
# Example: ENV=production

# ====================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ====================================================================
# This will be automatically constructed using the variables above
# Format: postgresql://username:password@localhost:5432/agromart2

# ====================================================================
# REDIS CONFIGURATION (REQUIRED)
# ====================================================================
# Redis database number (0-15)
REDIS_DB=0

# ====================================================================
# SECURITY CONFIGURATION (REQUIRED IN PRODUCTION - STARTUP WILL FAIL IF MISSING)
# ====================================================================
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# ! WARNING: PRODUCTION REQUIRES SECURE SECRETS - STARTUP WILL FAIL !
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# JWT Secret - Generate with: openssl rand -base64 32
# REQUIRED in production (minimum 32 characters)
# Auto-generated in development mode
JWT_SECRET=GENERATE_STRONG_256_BIT_SECRET_KEY_HERE

# CSRF Secret - Generate with: openssl rand -base64 32
# REQUIRED in production (minimum 32 characters)
# Auto-generated in development mode
CSRF_SECRET=GENERATE_STRONG_RANDOM_SECRET_HERE

# Session Secret - Generate with: openssl rand -base64 32
SESSION_SECRET=GENERATE_STRONG_RANDOM_SECRET_HERE

# Security Settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
ENFORCE_HTTPS=false

# ====================================================================
# SERVER CONFIGURATION
# ====================================================================
PORT=8080

# Frontend URL (used for CORS and email links)
FRONTEND_URL=http://localhost:3000

# ====================================================================
# MINIO / S3 CONFIGURATION (REQUIRED)
# ====================================================================
# SECURITY WARNING: Change these credentials in production!
MINIO_ENDPOINT=localhost:9003
MINIO_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_USE_SSL=false

# File Upload Limits
MAX_FILE_SIZE=10485760
# Allowed image types (comma-separated)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ====================================================================
# EMAIL CONFIGURATION (SMTP) - REQUIRED FOR PRODUCTION
# ====================================================================
# Leave empty for development (emails will be logged)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@agromart.com
SMTP_FROM_NAME=Agromart

# ====================================================================
# TWILIO CONFIGURATION (OPTIONAL - for SMS notifications)
# ====================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ====================================================================
# PAYMENT GATEWAY - RAZORPAY (OPTIONAL)
# ====================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ====================================================================
# SUPABASE CONFIGURATION (OPTIONAL - for external auth)
# ====================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ====================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ====================================================================
# These should also be in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8081/v1

# ====================================================================
# MONITORING & LOGGING (OPTIONAL)
# ====================================================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ====================================================================
# FEATURE FLAGS (OPTIONAL)
# ====================================================================
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_TALLY_INTEGRATION=true

# ====================================================================
# RATE LIMITING CONFIGURATION
# ====================================================================
# Global rate limit (requests per minute per IP)
RATE_LIMIT_GLOBAL=100
# Auth endpoints rate limit (requests per 15 minutes per IP)
RATE_LIMIT_AUTH=5
# Signup rate limit (requests per hour per IP)
RATE_LIMIT_SIGNUP=3

# ====================================================================
# NOTES
# ====================================================================
# 0. Set ENV=production when deploying to production environments
# 1. Generate secure secrets using: openssl rand -base64 32 (REQUIRED for production)
# 2. Never use default credentials in production
# 3. Enable HTTPS in production (ENFORCE_HTTPS=true)
# 4. Configure SMTP for email functionality
# 5. Set appropriate rate limits based on your needs
# 6. Review and update MAX_FILE_SIZE based on your storage capacity

# ====================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ====================================================================
# [ ] Set ENV=production
# [ ] Configure JWT_SECRET (32+ characters)
# [ ] Configure CSRF_SECRET (32+ characters)
# [ ] Change MinIO credentials from defaults
# [ ] Enable HTTPS (ENFORCE_HTTPS=true)
# [ ] Configure SMTP for email functionality
# [ ] Review and set appropriate rate limits
# 7. Application will fail to start in production mode if JWT_SECRET or CSRF_SECRET are missing
# 8. Development mode will auto-generate secrets with warnings (tokens reset on restart)
