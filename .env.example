# Environment Variables for Testing
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/agromart2

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-change-in-production

# Database Configuration
POSTGRES_PASSWORD=your-postgres-password-here

# Server Configuration
PORT=8080

# Supabase Configuration (Optional - for external auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# MinIO Configuration
MINIO_ENDPOINT=localhost:9003
MINIO_ACCESS_KEY=your-minio-access-key-here
MINIO_SECRET_KEY=your-minio-secret-key-here
MINIO_ROOT_USER=your-minio-root-user-here
MINIO_ROOT_PASSWORD=your-minio-root-password-here
MINIO_USE_SSL=false

# pgAdmin Configuration
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password-here

# Firebase Cloud Messaging Configuration (for push notifications)
# Download service account JSON from Firebase Console and provide the path
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
FCM_ENABLED=false

# Web Push Configuration (optional)
FIREBASE_WEB_VAPID_KEY=your-vapid-key-here

# Tally Import Configuration
TALLY_IMPORT_DIRECTORY=./tally_imports

# Email Configuration (FOR PRODUCTION EMAIL SENDING)
# IMPORTANT: For actual email delivery, follow these steps:
#
# 1. Sign up at https://resend.com
# 2. Create an API key at https://resend.com/dashboard/api-keys
# 3. Replace the placeholder below with your real API key
# 4. Verify your sending domain at https://resend.com/domains
# 5. Update FROM_EMAIL to match your verified domain
#
# The current key is a placeholder and will not send real emails!

RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME="Your App Name"

# MailHog Configuration
# The latest tag is multi-architecture and works on both ARM64 and x86 systems
MAILHOG_IMAGE=mailhog/mailhog:latest

# Local SMTP Configuration (for development/testing with MailHog)
# Comment out or set empty to force only Resend usage in production
# MailHog SMTP server runs on port 1025, web interface on port 8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@agromart.test
SMTP_FROM_NAME="Agromart Notifications"

# Production SMTP Configuration (optional - for email fallback)
# Uncomment and configure for production use
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=your-verified-email@yourdomain.com
# SMTP_FROM_NAME="Your App Name"

# Razorpay Configuration (FOR SUBSCRIPTION PAYMENTS)
# Get your keys from https://razorpay.com/dashboard/#/app/keys
# Use TEST keys (rzp_test_*) for development, LIVE keys (rzp_live_*) for production
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here