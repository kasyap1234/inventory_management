# Caddyfile for Agromart Single VM Deployment
# This file is auto-generated during deployment with the actual DOMAIN_NAME

{$DOMAIN_NAME} {
	# Backend API routes
	handle /v1/* {
		reverse_proxy backend:8080
	}
	
	# Health check endpoint
	handle /health {
		reverse_proxy backend:8080
	}
	
	# WebSocket support
	handle /ws {
		reverse_proxy backend:8080
	}
	
	# Metrics endpoint
	handle /metrics {
		reverse_proxy backend:8080
	}
	
	# Documentation static files
	handle /docs/* {
		reverse_proxy backend:8080
	}
	
	# Everything else goes to frontend
	handle /* {
		reverse_proxy frontend:3000
	}
}
