# =============================================================================
# AZURE CONTAINER APPS PRODUCTION ENVIRONMENT
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.prod and fill in your actual values
# 2. Generate strong random passwords for all _PASSWORD fields
# 3. Sign up at https://resend.com to get a real API key for email sending
# 4. Update the DOMAIN_NAME after first deployment (Azure assigns a default)
# 5. Never commit .env.prod to git - add it to .gitignore
#
# =============================================================================

# -----------------------------------------------------------------------------
# DOMAIN CONFIGURATION
# -----------------------------------------------------------------------------
# After first deployment, Azure will assign a domain like:
# agromart-backend.xxxxxx.centralindia.azurecontainerapps.io
# Update this to match your actual Azure Container Apps domain
DOMAIN_NAME=agromart-demo.centralindia.azurecontainerapps.io

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Generate a strong random password (32+ characters recommended)
POSTGRES_USER=agromart
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_32_CHARS_MIN
POSTGRES_DB=agromart
DATABASE_URL=postgresql://agromart:CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_32_CHARS_MIN@postgres:5432/agromart?sslmode=disable

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# MINIO (S3-COMPATIBLE STORAGE) CONFIGURATION
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_32_CHARS_MIN
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_32_CHARS_MIN
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# Generate strong random secrets (32+ characters, use openssl or similar):
# Linux/Mac: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_32_PLUS_CHARACTER_RANDOM_STRING
CSRF_SECRET=CHANGE_ME_TO_32_PLUS_CHARACTER_RANDOM_STRING
ENFORCE_HTTPS=true

# -----------------------------------------------------------------------------
# APPLICATION URLS
# -----------------------------------------------------------------------------
# These will be your Azure Container Apps URLs
FRONTEND_URL=https://agromart-demo.centralindia.azurecontainerapps.io
BACKEND_URL=https://agromart-demo.centralindia.azurecontainerapps.io/v1
NEXT_PUBLIC_API_URL=https://agromart-demo.centralindia.azurecontainerapps.io/v1

# -----------------------------------------------------------------------------
# RESEND EMAIL CONFIGURATION (CRITICAL FOR EMAIL VERIFICATION)
# -----------------------------------------------------------------------------
# 
# STEP 1: Sign up at https://resend.com
# STEP 2: Create an API key at https://resend.com/dashboard/api-keys
# STEP 3: Verify your domain at https://resend.com/domains
# STEP 4: Replace the placeholder below with your actual API key
#
# ⚠️  WITHOUT A REAL RESEND_API_KEY, EMAILS WILL NOT BE SENT!
#     Users won't be able to verify their email addresses.
#
# For testing/demo without custom domain, you can use Resend's test domain:
# RESEND_FROM_EMAIL=onboarding@resend.dev
# (Limited to sending only to your own email address)

RESEND_API_KEY=re_YOUR_ACTUAL_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=noreply@agromart-demo.com
RESEND_FROM_NAME=Agromart Inventory
FROM_EMAIL=noreply@agromart-demo.com
ADMIN_EMAIL=admin@agromart-demo.com

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENT CONFIGURATION (Optional for demo)
# -----------------------------------------------------------------------------
# Sign up at https://razorpay.com to enable subscription payments
# Leave empty to disable payment features
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# TWILIO SMS CONFIGURATION (Optional for demo)
# -----------------------------------------------------------------------------
# Sign up at https://twilio.com to enable SMS notifications
# Leave empty to disable SMS features
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# SUPER ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
# This account is created automatically on first startup
# Generate a strong password and keep it secure
SUPER_ADMIN_EMAIL=admin@agromart-demo.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_ADMIN_PASSWORD
