package services

import (
	"context"
	"fmt"
	"os"
	"strings"

	"agromart2/internal/models"
	"agromart2/internal/repositories"

	"github.com/google/uuid"
	"gopkg.in/yaml.v3"
)

// RoleTemplate represents a role template from YAML configuration
type RoleTemplate struct {
	Description string   `yaml:"description"`
	Permissions []string `yaml:"permissions"`
}

// PermissionGroup represents a named group of permissions
type PermissionGroup struct {
	Description string   `yaml:"description"`
	Permissions []string `yaml:"permissions"`
}

// RoleTemplateConfig represents the entire YAML configuration
type RoleTemplateConfig struct {
	Roles            map[string]RoleTemplate    `yaml:"roles"`
	PermissionGroups map[string]PermissionGroup `yaml:"permission_groups"`
}

// RBACTemplateService handles role template operations
type RBACTemplateService interface {
	LoadTemplates(configPath string) error
	GetTemplateNames() []string
	GetTemplate(name string) (*RoleTemplate, error)
	ApplyTemplateToTenant(ctx context.Context, tenantID uuid.UUID, templateName string) error
	ExpandWildcard(ctx context.Context, wildcardPermission string) ([]string, error)
	ExpandPermissions(ctx context.Context, permissions []string) ([]string, error)
	GetPermissionGroup(name string) (*PermissionGroup, error)
}

type rbacTemplateService struct {
	config             *RoleTemplateConfig
	roleRepo           repositories.RoleRepository
	permissionRepo     repositories.PermissionRepository
	rolePermissionRepo repositories.RolePermissionRepository
}

// NewRBACTemplateService creates a new RBAC template service
func NewRBACTemplateService(
	roleRepo repositories.RoleRepository,
	permissionRepo repositories.PermissionRepository,
	rolePermissionRepo repositories.RolePermissionRepository,
) RBACTemplateService {
	return &rbacTemplateService{
		config:             &RoleTemplateConfig{},
		roleRepo:           roleRepo,
		permissionRepo:     permissionRepo,
		rolePermissionRepo: rolePermissionRepo,
	}
}

// LoadTemplates loads role templates from YAML file
func (s *rbacTemplateService) LoadTemplates(configPath string) error {
	data, err := os.ReadFile(configPath)
	if err != nil {
		return fmt.Errorf("failed to read template config: %w", err)
	}

	var config RoleTemplateConfig
	if err := yaml.Unmarshal(data, &config); err != nil {
		return fmt.Errorf("failed to parse template config: %w", err)
	}

	s.config = &config
	return nil
}

// GetTemplateNames returns all available template names
func (s *rbacTemplateService) GetTemplateNames() []string {
	names := make([]string, 0, len(s.config.Roles))
	for name := range s.config.Roles {
		names = append(names, name)
	}
	return names
}

// GetTemplate retrieves a specific role template
func (s *rbacTemplateService) GetTemplate(name string) (*RoleTemplate, error) {
	template, exists := s.config.Roles[name]
	if !exists {
		return nil, fmt.Errorf("template '%s' not found", name)
	}
	return &template, nil
}

// GetPermissionGroup retrieves a specific permission group
func (s *rbacTemplateService) GetPermissionGroup(name string) (*PermissionGroup, error) {
	group, exists := s.config.PermissionGroups[name]
	if !exists {
		return nil, fmt.Errorf("permission group '%s' not found", name)
	}
	return &group, nil
}

// ExpandWildcard expands a wildcard permission pattern into concrete permissions
// Supports patterns like:
// - "*" (all permissions)
// - "product.*" (all product permissions)
// - "*.read" (all read permissions across resources)
// - "*.list" (all list permissions)
func (s *rbacTemplateService) ExpandWildcard(ctx context.Context, wildcardPermission string) ([]string, error) {
	// Get all permissions from database
	allPermissions, err := s.permissionRepo.ListPermissions(ctx)
	if err != nil {
		return nil, fmt.Errorf("failed to fetch permissions: %w", err)
	}

	var expanded []string

	// Handle "*" - all permissions
	if wildcardPermission == "*" {
		for _, perm := range allPermissions {
			expanded = append(expanded, perm.Name)
		}
		return expanded, nil
	}

	// Parse wildcard pattern
	parts := strings.Split(wildcardPermission, ".")
	if len(parts) != 2 {
		// Not a valid wildcard pattern, return as-is
		return []string{wildcardPermission}, nil
	}

	resourcePattern := parts[0]
	actionPattern := parts[1]

	// Match permissions based on pattern
	for _, perm := range allPermissions {
		permParts := strings.Split(perm.Name, ".")
		if len(permParts) != 2 {
			continue
		}

		resource := permParts[0]
		action := permParts[1]

		// Check if permission matches pattern
		resourceMatch := resourcePattern == "*" || resourcePattern == resource
		actionMatch := actionPattern == "*" || actionPattern == action

		if resourceMatch && actionMatch {
			expanded = append(expanded, perm.Name)
		}
	}

	return expanded, nil
}

// ExpandPermissions expands a list of permissions, resolving any wildcards
func (s *rbacTemplateService) ExpandPermissions(ctx context.Context, permissions []string) ([]string, error) {
	expandedSet := make(map[string]bool)

	for _, perm := range permissions {
		// Check if it's a wildcard pattern
		if strings.Contains(perm, "*") {
			expanded, err := s.ExpandWildcard(ctx, perm)
			if err != nil {
				return nil, fmt.Errorf("failed to expand wildcard '%s': %w", perm, err)
			}
			for _, p := range expanded {
				expandedSet[p] = true
			}
		} else {
			expandedSet[perm] = true
		}
	}

	// Convert set to slice
	result := make([]string, 0, len(expandedSet))
	for perm := range expandedSet {
		result = append(result, perm)
	}

	return result, nil
}

// ApplyTemplateToTenant applies a role template to a tenant
// Creates the role if it doesn't exist and assigns all permissions from the template
func (s *rbacTemplateService) ApplyTemplateToTenant(ctx context.Context, tenantID uuid.UUID, templateName string) error {
	// Get template
	template, err := s.GetTemplate(templateName)
	if err != nil {
		return err
	}

	// Check if role already exists
	existingRole, err := s.roleRepo.GetByName(ctx, tenantID, templateName)
	var role *models.Role

	if err == nil && existingRole != nil {
		// Role exists, use it
		role = existingRole
	} else {
		// Create new role
		role = &models.Role{
			ID:          uuid.New(),
			TenantID:    tenantID,
			Name:        templateName,
			Description: &template.Description,
		}
		if err := s.roleRepo.Create(ctx, role); err != nil {
			return fmt.Errorf("failed to create role: %w", err)
		}
	}

	// Expand all permissions (including wildcards)
	expandedPermissions, err := s.ExpandPermissions(ctx, template.Permissions)
	if err != nil {
		return fmt.Errorf("failed to expand permissions: %w", err)
	}

	// Assign permissions to role
	for _, permName := range expandedPermissions {
		// Get permission by name
		permission, err := s.permissionRepo.GetPermissionByName(ctx, permName)
		if err != nil {
			// Permission doesn't exist, skip it
			continue
		}
		if permission == nil {
			continue
		}

		// Create role-permission assignment
		rolePermission := &models.RolePermission{
			RoleID:       role.ID,
			PermissionID: permission.ID,
		}

		if err := s.rolePermissionRepo.Create(ctx, tenantID, rolePermission); err != nil {
			// Ignore duplicate errors
			if !strings.Contains(err.Error(), "duplicate") && !strings.Contains(err.Error(), "23505") {
				return fmt.Errorf("failed to assign permission '%s': %w", permName, err)
			}
		}
	}

	return nil
}
